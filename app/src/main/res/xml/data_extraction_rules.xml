<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 以降のバックアップ/端末間転送規則。
    秘密情報 (secure_prefs) は cloud-backup にも device-transfer にも含めない。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_prefs.xml" />
        <exclude domain="sharedpref" path="openrouter_prefs.xml" />
        <exclude domain="sharedpref" path="agent_connection_log.xml" />
        <exclude domain="file" path="models" />
        <exclude domain="file" path="llm_models" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_prefs.xml" />
        <exclude domain="sharedpref" path="openrouter_prefs.xml" />
        <exclude domain="file" path="models" />
        <exclude domain="file" path="llm_models" />
    </device-transfer>
</data-extraction-rules>
