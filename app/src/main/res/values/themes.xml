<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Material Design 3 ベースライン（ダーク）。アプリ全体をGoogle公式アプリ風のMD3配色に。 -->
    <style name="Base.Theme.Kennys_dokidoki_wallpaper" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#D0BCFF</item>
        <item name="colorOnPrimary">#381E72</item>
        <item name="colorPrimaryContainer">#4F378B</item>
        <item name="colorOnPrimaryContainer">#EADDFF</item>
        <item name="colorSecondary">#CCC2DC</item>
        <item name="colorSecondaryContainer">#4A4458</item>
        <item name="colorOnSecondaryContainer">#EADDFF</item>
        <item name="colorError">#F2B8B5</item>
        <item name="colorOutline">#938F99</item>
        <item name="colorOutlineVariant">#49454F</item>
        <item name="colorSurface">#1C1B1F</item>
        <item name="colorOnSurface">#E6E1E5</item>
        <item name="colorSurfaceVariant">#49454F</item>
        <item name="colorOnSurfaceVariant">#CAC4D0</item>
        <item name="android:colorBackground">#1C1B1F</item>
    </style>

    <style name="Theme.Kennys_dokidoki_wallpaper" parent="Base.Theme.Kennys_dokidoki_wallpaper" />

    <!-- AIチャットオーバーレイ用の透明なテーマ -->
    <style name="Theme.TransparentOverlay" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowShowWallpaper">true</item>
        <!-- ステータスバーとナビゲーションバーを透明に -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- タグ編集画面用のテーマ：背後のアプリ画面を動かさないように設定 -->
    <style name="Theme.TagEditorOverlay" parent="Theme.TransparentOverlay">
        <!-- windowShowWallpaperをfalseにすることで、アプリ内で開いた時に背後のActivityを維持させるわ -->
        <item name="android:windowShowWallpaper">false</item>
        <!-- 背景を少し暗くして編集画面を目立たせるわね -->
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.7</item>
    </style>

    <!-- ペルソナダイアログ用の透明テーマ -->
    <style name="Theme_TransparentDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
    </style>

    <!-- 編集ポップアップ。AlertDialogのwrap制限を避け、こちらで縦幅を固定する。 -->
    <style name="ThemeOverlay.Kennys.Md3Popup" parent="Theme.Material3.Dark.Dialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowMinWidthMajor">50%</item>
        <item name="android:windowMinWidthMinor">92%</item>
    </style>
</resources>