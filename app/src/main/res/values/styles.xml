<?xml version="1.0" encoding="utf-8"?>
<!--
    ウィジェット共通スタイル。レイアウト XML では style="@style/Widget.Kennys.*" を使い、
    Kotlin から setBackgroundColor / setTextColor / GradientDrawable で色や角丸を組み立てない。
-->
<resources>

    <!-- ===== Shape (MD3 shape scale) ===== -->
    <style name="ShapeAppearance.Kennys.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerSize">@dimen/radius_xs</item>
    </style>
    <style name="ShapeAppearance.Kennys.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">@dimen/radius_sm</item>
    </style>
    <style name="ShapeAppearance.Kennys.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/radius_md</item>
    </style>
    <style name="ShapeAppearance.Kennys.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">@dimen/radius_lg</item>
    </style>
    <style name="ShapeAppearance.Kennys.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">@dimen/radius_xl</item>
    </style>

    <!-- チャット吹き出し: 話者側の下角だけ小さくする -->
    <style name="ShapeAppearance.Kennys.Bubble.Ai" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_lg</item>
        <item name="cornerSizeBottomLeft">@dimen/radius_xs</item>
    </style>
    <style name="ShapeAppearance.Kennys.Bubble.User" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_lg</item>
        <item name="cornerSizeBottomRight">@dimen/radius_xs</item>
    </style>

    <!-- Base style for all Kennys widgets to allow implicit inheritance -->
    <style name="Widget.Kennys" parent="android:Widget" />

    <!-- ===== Buttons ===== -->
    <style name="Widget.Kennys.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.Kennys.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.Kennys.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.Kennys.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <!-- 削除 / 破棄 -->
    <style name="Widget.Kennys.Button.Text.Destructive">
        <item name="android:textColor">?attr/colorError</item>
        <item name="iconTint">?attr/colorError</item>
        <item name="rippleColor">?attr/colorErrorContainer</item>
    </style>
    <style name="Widget.Kennys.Button.Danger" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">?attr/colorErrorContainer</item>
        <item name="android:textColor">?attr/colorOnErrorContainer</item>
        <item name="iconTint">?attr/colorOnErrorContainer</item>
    </style>
    <!-- 生成ボタン: 進行中は「中断」に切り替わる。色は backgroundTint ではなく
         setEnabled/セレクタで切り替える -->
    <style name="Widget.Kennys.Button.Generate" parent="Widget.Material3.Button.Icon">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textAllCaps">false</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- アイコンボタン。TextView に "◀" を入れたタップ領域 20dp の疑似ボタンを置き換える -->
    <style name="Widget.Kennys.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="Widget.Kennys.IconButton.Tonal" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:minHeight">@dimen/touch_target</item>
    </style>

    <!-- ===== Text fields ===== -->
    <style name="Widget.Kennys.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_sm</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_sm</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_sm</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_sm</item>
    </style>
    <!-- API キー等: 目のアイコンで表示切替、既定は伏せ字 -->
    <style name="Widget.Kennys.TextInputLayout.Secret">
        <item name="endIconMode">password_toggle</item>
    </style>
    <!-- チャット入力欄 -->
    <style name="Widget.Kennys.TextInputLayout.ChatInput" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_xl</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_xl</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_xl</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_xl</item>
        <item name="hintEnabled">false</item>
    </style>

    <!-- ===== Cards ===== -->
    <style name="Widget.Kennys.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Kennys.Medium</item>
        <item name="cardElevation">0dp</item>
    </style>
    <style name="Widget.Kennys.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="shapeAppearance">@style/ShapeAppearance.Kennys.Medium</item>
    </style>
    <style name="Widget.Kennys.Card.Bubble.Ai" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Kennys.Bubble.Ai</item>
        <item name="cardElevation">0dp</item>
    </style>
    <style name="Widget.Kennys.Card.Bubble.User" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorPrimaryContainer</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Kennys.Bubble.User</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- ===== App bars ===== -->
    <style name="Widget.Kennys.Toolbar" parent="Widget.Material3.Toolbar.OnSurface">
        <item name="titleTextAppearance">?attr/textAppearanceTitleLarge</item>
        <item name="titleCentered">false</item>
    </style>

    <!-- ===== Bottom sheet ===== -->
    <style name="Widget.Kennys.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.Kennys.ExtraLarge</item>
        <item name="backgroundTint">?attr/colorSurfaceContainerLow</item>
    </style>

    <!-- ===== Text appearances (MD3 type scale へのエイリアス) ===== -->
    <style name="TextAppearance.Kennys.SectionLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
    <style name="TextAppearance.Kennys.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="TextAppearance.Kennys.Bubble" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <!-- ===== 設定リスト行 ===== -->
    <style name="Widget.Kennys.ListItem">
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:orientation">horizontal</item>
    </style>
</resources>
