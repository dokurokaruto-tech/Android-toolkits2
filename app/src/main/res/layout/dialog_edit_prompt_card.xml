<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- タイトル -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="プロンプトカードの編集"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="24dp"
            tools:ignore="HardcodedText"
            xmlns:tools="http://schemas.android.com/tools" />

        <!-- カテゴリー -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="カテゴリー"
            app:boxStrokeColor="?attr/colorOutline"
            app:hintTextColor="?attr/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_card_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ラベル -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="ラベル"
            app:boxStrokeColor="?attr/colorOutline"
            app:hintTextColor="?attr/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_card_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- メインプロンプト -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="メインプロンプト"
            app:boxStrokeColor="?attr/colorOutline"
            app:hintTextColor="?attr/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_main_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:minLines="3"
                android:gravity="top" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ネガティブプロンプト -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="ネガティブプロンプト"
            app:boxStrokeColor="?attr/colorOutline"
            app:hintTextColor="?attr/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_negative_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:minLines="2"
                android:gravity="top" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- タグ -->
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="自動付与するタグ"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="4dp"
            tools:ignore="HardcodedText"
            xmlns:tools="http://schemas.android.com/tools" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_applied_tags_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="なし"
            android:textColor="?attr/colorPrimary"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:paddingVertical="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit_applied_tags"
            style="@style/Widget.Material3.Button.TonalButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="タグを選択"
            app:icon="@drawable/ic_md3_check"
            android:layout_marginBottom="24dp"
            tools:ignore="HardcodedText"
            xmlns:tools="http://schemas.android.com/tools" />

        <!-- ランダマイザー -->
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="個別ランダマイザー"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="8dp"
            tools:ignore="HardcodedText"
            xmlns:tools="http://schemas.android.com/tools" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/cb_use_individual_randomizer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="個別ランダマイザーを有効にする"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="8dp"
            tools:ignore="HardcodedText"
            xmlns:tools="http://schemas.android.com/tools" />

        <LinearLayout
            android:id="@+id/ll_randomizer_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="出現確率："
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:ignore="HardcodedText"
                    xmlns:tools="http://schemas.android.com/tools" />

                <EditText
                    android:id="@+id/et_random_probability"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="50"
                    android:textColor="?attr/colorPrimary"
                    android:gravity="center"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" %"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:ignore="HardcodedText"
                    xmlns:tools="http://schemas.android.com/tools" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sb_random_probability"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="50"
                android:progressTint="?attr/colorPrimary"
                android:thumbTint="?attr/colorPrimary" />
        </LinearLayout>

        <!-- サムネイル -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_thumbnail_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="サムネイル (9:16を推奨)"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="8dp"
            tools:ignore="HardcodedText"
            xmlns:tools="http://schemas.android.com/tools" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="120dp"
            android:layout_height="213dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/iv_card_thumbnail_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="?attr/colorSurfaceVariant" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pick_card_thumbnail"
                style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="選択"
                app:icon="@drawable/ic_md3_photo_library"
                android:layout_marginEnd="8dp"
                tools:ignore="HardcodedText"
                xmlns:tools="http://schemas.android.com/tools" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_generate_card_thumbnail"
                style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="生成"
                app:icon="@drawable/ic_md3_auto_awesome"
                tools:ignore="HardcodedText"
                xmlns:tools="http://schemas.android.com/tools" />
        </LinearLayout>

        <!-- アクションボタン -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_card"
                style="@style/Widget.Material3.Button.TextButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="削除"
                android:textColor="?attr/colorError"
                app:icon="@drawable/ic_md3_delete"
                app:iconTint="?attr/colorError"
                android:visibility="gone"
                tools:ignore="HardcodedText"
                xmlns:tools="http://schemas.android.com/tools" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel_edit"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="キャンセル"
                tools:ignore="HardcodedText"
                xmlns:tools="http://schemas.android.com/tools" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_card"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="保存"
                tools:ignore="HardcodedText"
                xmlns:tools="http://schemas.android.com/tools" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
