<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- 複数選択モード用のアクションバー -->
    <LinearLayout
        android:id="@+id/selection_action_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#1C1B1F"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btn_selection_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#E6E1E5" />

        <TextView
            android:id="@+id/tv_selection_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1 selected"
            android:textColor="#E6E1E5"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            tools:ignore="HardcodedText" />

        <Button
            android:id="@+id/btn_select_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="すべて選択"
            android:textColor="#D0BCFF"
            android:textStyle="bold"
            android:backgroundTint="#00000000"
            tools:ignore="HardcodedText" />

        <ImageButton
            android:id="@+id/btn_selection_inspect"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_view"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#D0BCFF" />

        <ImageButton
            android:id="@+id/btn_selection_tag"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_edit"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#D0BCFF" />

        <ImageButton
            android:id="@+id/btn_selection_delete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FF3366" />
    </LinearLayout>

    <!-- 操作バーのコンテナ -->
    <LinearLayout
        android:id="@+id/action_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/selection_action_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 全画像タブ専用の操作バー -->
        <LinearLayout
            android:id="@+id/all_images_action_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="#1C1B1F"
            android:visibility="visible">

            <ImageButton
                android:id="@+id/btn_priority_sort"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_persona_item"
                android:src="@android:drawable/stat_notify_sync"
                app:tint="#D0BCFF"
                android:contentDescription="優先度順に並べ替え"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tv_filter_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text=""
                android:textColor="#CAC4D0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_quick_sort"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="クイックソート"
                android:textColor="#D0BCFF"
                android:textSize="12sp"
                android:textAllCaps="false"
                style="@style/Widget.Material3.Button.TextButton"
                tools:ignore="HardcodedText" />

            <ImageButton
                android:id="@+id/btn_sort_direction"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_persona_item"
                android:src="@android:drawable/arrow_up_float"
                app:tint="#D0BCFF" />

            <CheckBox
                android:id="@+id/cb_show_tags"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="タグ表示"
                android:textColor="#CAC4D0"
                android:button="@drawable/checkbox_minimal_selector"
                android:paddingStart="6dp"
                android:textSize="11sp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- イメージセットタブ専用の操作バー -->
        <LinearLayout
            android:id="@+id/image_sets_action_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="#1C1B1F"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_sets_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="イメージセット"
                android:textColor="#E6E1E5"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/nav_host_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/action_bar_container">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_sets"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="80dp"
            android:visibility="gone"
            android:scrollbars="vertical" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_all_images"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="80dp"
            android:visibility="visible"
            android:scrollbars="vertical" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_tag_prompts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp"
            android:paddingBottom="80dp"
            android:visibility="gone" />

        <!-- Prompt-Builder 画面 -->
        <LinearLayout
            android:id="@+id/layout_builder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- ★常駐: タイトル＋ボタン類 -->
            <LinearLayout
                android:id="@+id/ll_builder_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Prompt-Builder"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="#D0BCFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <Button
                    android:id="@+id/btn_switch_columns"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="2列"
                    android:textSize="12sp"
                    android:textColor="#D0BCFF"
                    android:layout_marginEnd="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    style="@style/Widget.Material3.Button.TextButton"
                    tools:ignore="HardcodedText" />

                <Button
                    android:id="@+id/btn_save_preset"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="保存"
                    app:icon="@drawable/ic_md3_save"
                    app:iconSize="16dp"
                    android:textSize="12sp"
                    android:textColor="#D0BCFF"
                    android:layout_marginEnd="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    style="@style/Widget.Material3.Button.TextButton"
                    tools:ignore="HardcodedText" />

                <Button
                    android:id="@+id/btn_restore_pip"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:padding="0dp"
                    android:text="🖼️"
                    android:textSize="16sp"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:visibility="gone"
                    tools:ignore="HardcodedText" />

                <Button
                    android:id="@+id/btn_view_generated"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    app:icon="@drawable/ic_md3_photo_library"
                    app:iconSize="16dp"
                    android:padding="0dp"
                    android:text="閲覧"
                    android:textSize="12sp"
                    android:textColor="#D0BCFF"
                    style="@style/Widget.Material3.Button.TextButton"
                    tools:ignore="HardcodedText" />

                <Button
                    android:id="@+id/btn_generate_concatenated_top"
                    android:layout_width="64dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:padding="0dp"
                    android:text="生成"
                    android:textSize="12sp"
                    android:textColor="#E6E1E5"
                    app:icon="@drawable/ic_md3_auto_awesome"
                    app:iconSize="16dp"
                    style="@style/Widget.Material3.Button"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <!-- ★常駐: 生成設定 -->
            <LinearLayout
                android:id="@+id/layout_gen_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="12dp"
                android:background="#1C1B1F">

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <LinearLayout android:id="@+id/btn_setting_resolution" android:layout_width="wrap_content" android:layout_height="32dp" android:background="@drawable/bg_persona_item" android:paddingHorizontal="10dp" android:gravity="center"><TextView android:id="@+id/tv_setting_resolution" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="720 x 1280" android:textColor="#D0BCFF" android:textSize="11sp" android:textStyle="bold" /></LinearLayout>
                        <LinearLayout android:id="@+id/btn_setting_steps" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="8dp" android:background="@drawable/bg_persona_item" android:paddingHorizontal="10dp" android:gravity="center"><TextView android:id="@+id/tv_setting_steps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Steps: 20" android:textColor="#D0BCFF" android:textSize="11sp" /></LinearLayout>
                        <LinearLayout android:id="@+id/btn_setting_batch" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="8dp" android:background="@drawable/bg_persona_item" android:paddingHorizontal="10dp" android:gravity="center"><TextView android:id="@+id/tv_setting_batch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Batch: 1" android:textColor="#D0BCFF" android:textSize="11sp" /></LinearLayout>
                        <LinearLayout android:id="@+id/btn_setting_sampler" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="8dp" android:background="@drawable/bg_persona_item" android:paddingHorizontal="10dp" android:gravity="center"><TextView android:id="@+id/tv_setting_sampler" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Euler a" android:textColor="#D0BCFF" android:textSize="11sp" /></LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>

                <ImageButton
                    android:id="@+id/btn_reset_builder"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:src="@android:drawable/ic_menu_revert"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#CAC4D0"
                    android:contentDescription="設定のリセット"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <!-- スクロール可能: プリセット＋カード -->
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tv_presets_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▼ プリセット"
                        android:textColor="#CAC4D0"
                        android:textSize="12sp"
                        android:paddingStart="16dp"
                        android:layout_marginTop="8dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_view_presets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:padding="8dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_presets_header" />

                    <TextView
                        android:id="@+id/tv_cards_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▼ プロンプトカード"
                        android:textColor="#CAC4D0"
                        android:textSize="12sp"
                        android:paddingStart="16dp"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@id/recycler_view_presets"
                        app:layout_constraintStart_toStartOf="parent" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_view_prompt_cards"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:padding="8dp"
                        android:paddingBottom="100dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_cards_header" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- ★常駐: 選択中カード横スクロール（下部） -->
            <LinearLayout
                android:id="@+id/layout_selected_strip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1C1B1F"
                android:padding="6dp"
                android:elevation="8dp">

                <TextView
                    android:id="@+id/tv_selected_strip_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="選択中のカード（タップで解除）"
                    android:textColor="#CAC4D0"
                    android:textSize="10sp"
                    android:paddingStart="6dp"
                    android:paddingBottom="2dp"
                    tools:ignore="HardcodedText" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_selected_cards"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:scrollbars="horizontal" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/content_placeholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Hello World!"
            android:visibility="gone"
            tools:ignore="HardcodedText" />
    </FrameLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_album"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/add_album"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@android:drawable/ic_input_add"
        android:backgroundTint="#4A148C"
        app:tint="#E6E1E5" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_prompt_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@android:drawable/ic_input_add"
        android:backgroundTint="#4A148C"
        app:tint="#E6E1E5"
        android:contentDescription="新しいカテゴリーを追加"
        tools:ignore="HardcodedText" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
