<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/diary_page_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="4dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_diary_back"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:minWidth="48dp"
            android:text="[戻る]"
            android:textColor="#FFFF2020"
            android:textSize="12sp"
            android:typeface="monospace" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_diary_palette"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:minWidth="64dp"
            android:text="[配色設定]"
            android:textColor="#FFFF2020"
            android:textSize="12sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/btn_diary_backup"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:minWidth="72dp"
            android:text="[バックアップ]"
            android:textColor="#FFFF2020"
            android:textSize="12sp"
            android:typeface="monospace" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/diary_mini_graph_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:minHeight="84dp"
        android:orientation="horizontal"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/diary_mini_weekday_labels"
            android:layout_width="18dp"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.example.kennys_dokidoki_wallpaper.DiaryContributionGraphView
            android:id="@+id/diary_mini_graph"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:importantForAccessibility="yes" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/diary_entry_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/diary_entry_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="64dp"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/diary_entry_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="20dp">

                <TextView
                    android:id="@+id/tv_diary_selected_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="10dp"
                    android:textColor="#FFFF5555"
                    android:textSize="16sp"
                    android:typeface="serif" />

                <FrameLayout
                    android:id="@+id/diary_content_canvas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_diary_inline_text"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="今日のできごと"
                        android:visibility="gone"
                        app:boxBackgroundMode="none"
                        app:hintTextColor="#FFFF5555">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_diary_inline_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:fontFamily="serif"
                            android:gravity="top|start"
                            android:inputType="textMultiLine|textCapSentences"
                            android:lineSpacingExtra="4dp"
                            android:minHeight="48dp"
                            android:paddingStart="0dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="0dp"
                            android:paddingBottom="8dp"
                            android:textColor="#FFFF3030"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <FrameLayout
                        android:id="@+id/diary_photo_canvas"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/diary_canvas_height"
                        android:background="@android:color/transparent"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_diary_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top"
                        android:paddingTop="6dp"
                        android:paddingBottom="8dp"
                        android:text="この日の日記はまだありません。"
                        android:textColor="#FFB32323"
                        android:textSize="14sp"
                        android:typeface="serif"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_diary_photo_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:textColor="#FFB32323"
                    android:textSize="12sp"
                    android:typeface="monospace"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_diary_photo_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp"
                    android:text="写真はドラッグで移動、ピンチで拡大縮小、長押しで削除できます。"
                    android:textColor="#FFB32323"
                    android:textSize="12sp"
                    android:typeface="serif"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <View
            android:id="@+id/diary_entry_fade"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_gravity="top"
            android:layout_marginTop="48dp"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/diary_entry_actions"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="top"
            android:background="#000000"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/btn_diary_edit"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="[ この日の日記を編集する ]"
                android:textColor="#FFFF2020"
                android:textSize="14sp"
                android:typeface="serif" />

            <TextView
                android:id="@+id/btn_diary_add_photo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="[ 画像を追加する ]"
                android:textColor="#FFFF2020"
                android:textSize="14sp"
                android:typeface="serif"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
