<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/diary_page_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="4dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_diary_back"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:minWidth="48dp"
            android:text="[戻る]"
            android:textColor="#FFFF2020"
            android:textSize="12sp"
            android:typeface="monospace" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_diary_palette"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:minWidth="64dp"
            android:text="[配色設定]"
            android:textColor="#FFFF2020"
            android:textSize="12sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/btn_diary_backup"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:minWidth="72dp"
            android:text="[バックアップ]"
            android:textColor="#FFFF2020"
            android:textSize="12sp"
            android:typeface="monospace" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/diary_mini_graph_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:minHeight="84dp"
        android:orientation="horizontal"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/diary_mini_weekday_labels"
            android:layout_width="18dp"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.example.kennys_dokidoki_wallpaper.DiaryContributionGraphView
            android:id="@+id/diary_mini_graph"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:importantForAccessibility="yes" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/diary_entry_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/diary_entry_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/tv_diary_selected_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp"
                android:textColor="#FFFF5555"
                android:textSize="16sp"
                android:typeface="serif" />

            <TextView
                android:id="@+id/tv_diary_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:minHeight="48dp"
                android:textColor="#FFFF3030"
                android:textIsSelectable="true"
                android:textSize="15sp"
                android:typeface="serif" />

            <TextView
                android:id="@+id/tv_diary_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:paddingBottom="8dp"
                android:text="この日の日記はまだありません。"
                android:textColor="#FFB32323"
                android:textSize="14sp"
                android:typeface="serif"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_diary_photo_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:textColor="#FFB32323"
                android:textSize="12sp"
                android:typeface="monospace"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btn_diary_edit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="[ この日の日記を編集する ]"
                android:textColor="#FFFF2020"
                android:textSize="14sp"
                android:typeface="serif" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
