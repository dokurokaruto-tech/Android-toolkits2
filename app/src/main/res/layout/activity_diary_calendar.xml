<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/diary_page_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls"
    android:scrollbars="vertical">

    <LinearLayout
        android:id="@+id/diary_page_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_diary_back"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center"
                android:minWidth="48dp"
                android:text="[戻る]"
                android:textColor="#FFFF2020"
                android:textSize="12sp"
                android:typeface="monospace" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btn_diary_palette"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center"
                android:minWidth="64dp"
                android:text="[配色設定]"
                android:textColor="#FFFF2020"
                android:textSize="12sp"
                android:typeface="monospace" />

            <TextView
                android:id="@+id/btn_diary_backup"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center"
                android:minWidth="72dp"
                android:text="[バックアップ]"
                android:textColor="#FFFF2020"
                android:textSize="12sp"
                android:typeface="monospace" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_diary_page_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="2dp"
            android:text="│　管理人の手記　│"
            android:textColor="#FFFF6969"
            android:textSize="24sp"
            android:typeface="serif" />

        <TextView
            android:id="@+id/tv_diary_page_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="10dp"
            android:text="―　日々の記録　―"
            android:textColor="#FFFF3030"
            android:textSize="12sp"
            android:typeface="serif" />

        <View
            android:id="@+id/v_diary_header_rule"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FF6B1010" />

        <TextView
            android:id="@+id/tv_diary_graph_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:text="■ 日記の足あと"
            android:textColor="#FFFF3030"
            android:textSize="14sp"
            android:typeface="serif" />

        <TextView
            android:id="@+id/tv_diary_graph_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:text="日曜日から土曜日まで / 最近24週間"
            android:textColor="#FFB32323"
            android:textSize="11sp"
            android:typeface="monospace" />

        <LinearLayout
            android:id="@+id/diary_mini_graph_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="84dp"
            android:orientation="horizontal"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/diary_mini_weekday_labels"
                android:layout_width="18dp"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.example.kennys_dokidoki_wallpaper.DiaryContributionGraphView
                android:id="@+id/diary_mini_graph"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:importantForAccessibility="yes" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_diary_open_graph"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="[ 詳しいカレンダーを開く ]"
            android:textColor="#FFFF2020"
            android:textSize="13sp"
            android:typeface="serif" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:background="#FF6B1010" />

        <LinearLayout
            android:id="@+id/diary_entry_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_diary_selected_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFF5555"
                android:textSize="16sp"
                android:typeface="serif" />

            <View
                android:id="@+id/v_diary_entry_rule"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="10dp"
                android:background="#FF4D1111" />

            <TextView
                android:id="@+id/tv_diary_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:minHeight="48dp"
                android:textColor="#FFFF3030"
                android:textIsSelectable="true"
                android:textSize="15sp"
                android:typeface="serif" />

            <TextView
                android:id="@+id/tv_diary_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="この日の日記はまだありません。"
                android:textColor="#FFB32323"
                android:textSize="14sp"
                android:typeface="serif"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_diary_photo_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:textColor="#FFB32323"
                android:textSize="12sp"
                android:typeface="monospace"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btn_diary_edit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="[ この日の日記を編集する ]"
                android:textColor="#FFFF2020"
                android:textSize="14sp"
                android:typeface="serif" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_backup_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="14dp"
            android:paddingBottom="8dp"
            android:text="バックアップ先: 未設定"
            android:textColor="#FF8E2424"
            android:textSize="11sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/tv_diary_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="8dp"
            android:text="……　日記帳はここから続く　……"
            android:textColor="#FF6B1010"
            android:textSize="11sp"
            android:typeface="serif" />
    </LinearLayout>
</ScrollView>
