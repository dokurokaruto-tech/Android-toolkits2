<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="6dp"
    android:paddingBottom="18dp"
    android:background="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/threejs_tile_thumb"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#050507"
            android:scaleType="centerCrop"
            android:contentDescription="three.js work screenshot"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintDimensionRatio="1:1" />

        <TextView
            android:id="@+id/threejs_tile_rendering_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="rendering..."
            android:textColor="#4A4A54"
            android:textSize="11sp"
            android:fontFamily="monospace"
            app:layout_constraintTop_toTopOf="@id/threejs_tile_thumb"
            app:layout_constraintBottom_toBottomOf="@id/threejs_tile_thumb"
            app:layout_constraintStart_toStartOf="@id/threejs_tile_thumb"
            app:layout_constraintEnd_toEndOf="@id/threejs_tile_thumb" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:layout_width="86dp"
        android:layout_height="1dp"
        android:layout_marginTop="9dp"
        android:background="#202026" />

    <TextView
        android:id="@+id/threejs_tile_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:letterSpacing="0.05"
        android:textColor="#787882"
        android:textSize="11.5sp" />

</LinearLayout>
