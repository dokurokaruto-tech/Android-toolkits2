<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/diary_graph_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#000000"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_diary_graph_previous_year"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:minWidth="68dp"
            android:paddingHorizontal="4dp"
            android:text="&lt;&lt; 前年"
            android:textColor="#FFFF2020"
            android:textSize="12sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/tv_diary_graph_year"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#FFFF2020"
            android:textSize="18sp"
            android:typeface="serif" />

        <TextView
            android:id="@+id/btn_diary_graph_next_year"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:minWidth="68dp"
            android:paddingHorizontal="4dp"
            android:text="翌年 &gt;&gt;"
            android:textColor="#FFFF2020"
            android:textSize="12sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/btn_diary_graph_close"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingStart="4dp"
            android:text="[×]"
            android:textColor="#FFFF2020"
            android:textSize="13sp"
            android:typeface="monospace" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/diary_graph_weekday_labels"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <HorizontalScrollView
            android:id="@+id/diary_graph_horizontal_scroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fillViewport="false"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/diary_graph_month_labels"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:id="@+id/diary_graph_week_columns"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>
