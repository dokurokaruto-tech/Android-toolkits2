<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_thumbnail_folder"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationIcon="@drawable/ic_md3_close"
        app:navigationIconTint="?attr/colorOnSurface"
        app:title="サムネイルの保存フォルダ" />

    <TextView
        android:id="@+id/tv_folder_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_open_explorer"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginRight="8dp"
        android:text="エクスプローラーで開くを試す" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_thumbnail_files"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tv_folder_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="保存されたサムネイルはまだ無い。"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <!-- タップした1枚を大きく見るオーバーレイ -->
    <FrameLayout
        android:id="@+id/overlay_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_overlay_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/pip_action_live_preview" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="32dp"
            android:text="タップで閉じる"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </FrameLayout>
</LinearLayout>
