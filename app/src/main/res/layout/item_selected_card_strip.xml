<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/strip_card_root"
    android:layout_width="80dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="6dp"
    app:cardBackgroundColor="#211F26"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="#00F0FF"
    app:strokeWidth="3dp"
    android:clickable="true"
    android:focusable="true"
    app:rippleColor="#3300F0FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="3dp">

        <ImageView
            android:id="@+id/strip_card_thumbnail"
            android:layout_width="72dp"
            android:layout_height="104dp"
            android:scaleType="centerCrop"
            android:contentDescription="card thumbnail" />

        <TextView
            android:id="@+id/strip_card_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="label"
            android:textColor="#E6E1E5"
            android:textSize="9sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:gravity="center" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
