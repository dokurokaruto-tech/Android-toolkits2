<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/full_screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 背景View。背景をクリックしても戻れるように。エフェクトはなしよ！ -->
    <View
        android:id="@+id/blank_space_handler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <!-- 画像表示 -->
    <com.example.kennys_dokidoki_wallpaper.ProgressiveTileImageView
        android:id="@+id/full_screen_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        android:contentDescription="Full Screen Image"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintDimensionRatio="1:1" />

    <!-- ナビゲーション用のエリア。backgroundを@nullにすることでエフェクトを消すわ -->
    <LinearLayout
        android:id="@+id/image_nav_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintBottom_toBottomOf="@id/full_screen_image"
        app:layout_constraintEnd_toEndOf="@id/full_screen_image"
        app:layout_constraintStart_toStartOf="@id/full_screen_image"
        app:layout_constraintTop_toTopOf="@id/full_screen_image">

        <View
            android:id="@+id/zone_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null" />

        <View
            android:id="@+id/zone_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null" />

    </LinearLayout>

    <ImageView
        android:id="@+id/btn_create_preset_from_image"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_counter_bubble"
        android:clickable="true"
        android:contentDescription="この構成をプリセットに"
        android:focusable="true"
        android:padding="10dp"
        android:src="@drawable/ic_md3_save"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#E6E1E5" />

    <!-- 削除 / 枚数 / 仮チャット。削除は枚数とチャットの左。 -->
    <LinearLayout
        android:id="@+id/viewer_chrome_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/btn_delete_image"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_counter_bubble"
            android:clickable="true"
            android:contentDescription="削除"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_md3_delete"
            android:visibility="gone"
            app:tint="#E6E1E5" />

        <TextView
            android:id="@+id/tv_image_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_counter_bubble"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="1 / 1"
            android:textColor="#E6E1E5"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/btn_start_temp_chat"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_counter_bubble"
            android:clickable="true"
            android:contentDescription="仮チャット"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_md3_chat"
            android:visibility="gone"
            app:tint="#E6E1E5" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
