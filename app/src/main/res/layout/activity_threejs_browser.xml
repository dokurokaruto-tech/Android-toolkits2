<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D11">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Omnibox & Browser Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#121218"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/btn_browser_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="閉じる"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#B8B8C6" />

            <ImageButton
                android:id="@+id/btn_browser_back"
                android:layout_width="34dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="戻る"
                android:src="@android:drawable/ic_media_previous"
                app:tint="#B8B8C6" />

            <ImageButton
                android:id="@+id/btn_browser_forward"
                android:layout_width="34dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="進む"
                android:src="@android:drawable/ic_media_next"
                app:tint="#B8B8C6" />

            <EditText
                android:id="@+id/edit_browser_url"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="#1C1C26"
                android:fontFamily="monospace"
                android:hint="URL または Google 検索"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="#ECECF6"
                android:textColorHint="#6C6C7A"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btn_browser_reload"
                android:layout_width="34dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="再読み込み"
                android:src="@android:drawable/ic_popup_sync"
                app:tint="#B8B8C6" />

            <TextView
                android:id="@+id/btn_browser_devtools_toggle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="DevTools (0)"
                android:textColor="#8CE0A8"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/browser_load_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:max="100"
            android:progressTint="#60A5FA"
            android:visibility="gone" />

        <!-- WebView Viewport -->
        <WebView
            android:id="@+id/threejs_discovery_webview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Docked PC-Style Developer Console -->
        <LinearLayout
            android:id="@+id/devtools_dock_panel"
            android:layout_width="match_parent"
            android:layout_height="270dp"
            android:background="#0E0E14"
            android:orientation="vertical"
            android:visibility="visible">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2A2A38" />

            <!-- DevTools Header Tabs & Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="#15151E"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/tab_devtools_network"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Network"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tab_devtools_console"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Console"
                    android:textColor="#888898"
                    android:textSize="11.5sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btn_devtools_scan_page"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginEnd="6dp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="JSON探索"
                    android:textColor="#93C5FD"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/btn_devtools_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Clear"
                    android:textColor="#9E9EAE"
                    android:textSize="10.5sp" />

            </LinearLayout>

            <!-- Network Pane -->
            <LinearLayout
                android:id="@+id/pane_devtools_network"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Smart Filter Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:background="#111118"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:id="@+id/chip_filter_candidates"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="★ Three.js / JSON"
                        android:textColor="#8CE0A8"
                        android:textSize="10.5sp" />

                    <TextView
                        android:id="@+id/chip_filter_all"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="6dp"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="すべて"
                        android:textColor="#9E9EAE"
                        android:textSize="10.5sp" />

                    <TextView
                        android:id="@+id/chip_filter_scripts"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="6dp"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="JS"
                        android:textColor="#9E9EAE"
                        android:textSize="10.5sp" />

                    <TextView
                        android:id="@+id/txt_three_engine_badge"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:singleLine="true"
                        android:text=""
                        android:textColor="#7DD3FC"
                        android:textSize="10sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1E1E28" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_devtools_network"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:id="@+id/txt_network_empty_hint"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:padding="16dp"
                        android:text="通信を監視中です。three.js 作品ページを開くとダウンロードされた .json 候補がここに表示されます。"
                        android:textColor="#6C6C7C"
                        android:textSize="11sp" />

                </FrameLayout>

            </LinearLayout>

            <!-- Console Pane -->
            <LinearLayout
                android:id="@+id/pane_devtools_console"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <ScrollView
                    android:id="@+id/scroll_devtools_console"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/txt_devtools_console_log"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="#D4D4E0"
                        android:textIsSelectable="true"
                        android:textSize="11sp" />
                </ScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="#15151E"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="&gt; "
                        android:textColor="#60A5FA"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edit_console_eval"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:fontFamily="monospace"
                        android:hint="JavaScript 式を実行 (例: window.THREE)"
                        android:imeOptions="actionSend"
                        android:inputType="textNoSuggestions"
                        android:singleLine="true"
                        android:textColor="#ECECF6"
                        android:textColorHint="#666676"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/btn_console_run"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="Run"
                        android:textColor="#93C5FD"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- In-Browser File Inspector Overlay -->
    <LinearLayout
        android:id="@+id/inspector_overlay_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F20D0D12"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/inspector_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:text="File Inspector"
                android:textColor="#F0F0F8"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_inspector_close"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="閉じる"
                android:textColor="#B8B8C8"
                android:textSize="11.5sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/inspector_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="middle"
            android:fontFamily="monospace"
            android:maxLines="2"
            android:textColor="#7D8597"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/inspector_diagnosis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#181924"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:textColor="#8CE0A8"
            android:textSize="11.5sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:background="#08080C"
            android:padding="10dp">

            <TextView
                android:id="@+id/inspector_body_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#DCDCE8"
                android:textIsSelectable="true"
                android:textSize="11sp" />

        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edit_inspector_import_name"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="#181924"
                android:fontFamily="monospace"
                android:hint="インポートする作品名"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="#F0F0F8"
                android:textColorHint="#6E6E7E"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btn_inspector_import_json"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="この .json をインポート"
                android:textColor="#0B1911"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
