<?xml version="1.0" encoding="utf-8"?>
<!-- 采配コンシェルジュのチャット1行分。ユーザーは右、コンシェルジュは左。AIキャラチャットのバブルを踏襲 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="6dp"
    android:paddingTop="6dp">

    <LinearLayout
        android:id="@+id/row_user"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_concierge_user"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_bubble_user"
            android:maxWidth="280dp"
            android:padding="12dp"
            android:textColor="#E6E1E5"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_assistant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_concierge_assistant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_bubble_ai"
            android:maxWidth="280dp"
            android:padding="12dp"
            android:textColor="#E6E1E5"
            android:textSize="14sp" />

        <!-- 動かした機能とJevの確信度（例: 🛠 カード編集 · Jev確信度82%） -->
        <TextView
            android:id="@+id/tv_concierge_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_concierge_applied"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:text="@string/concierge_applied"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_concierge_action"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/concierge_confirm_view"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
